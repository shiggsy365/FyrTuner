<?xml version="1.0" encoding="utf-8"?>
<!-- Programme cell: white when highlighted, a little lighter when it's on air now. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><corners android:radius="3dp" /><solid android:color="@color/guide_focus" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><corners android:radius="3dp" /><solid android:color="#FF262935" /></shape>
    </item>
    <item>
        <shape><corners android:radius="3dp" /><solid android:color="#FF1A1C24" /></shape>
    </item>
</selector>
